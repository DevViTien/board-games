{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "apps/web": {
      "playwright": { "config": ["playwright.config.ts", "playwright.shots.config.ts"] }
    },
    "packages/config": {
      "ignoreUnresolved": ["next"]
    },
    "packages/*": {}
  },
  // A change's approved mockup (plain scripts opened from file://), kept as the user approved it:
  // reference files, not app code.
  "ignore": ["openspec/changes/**/mockup/**"]
}
