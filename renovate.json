{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "schedule": ["before 9am on monday"],
  "timezone": "Asia/Ho_Chi_Minh",
  "packageRules": [
    {
      "description": "One weekly PR for all minor and patch updates.",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "typescript-eslint 8.x supports TypeScript < 6.1.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1"
    },
    {
      "description": "eslint-config-next's plugins still peer on ESLint 9.",
      "matchPackageNames": ["eslint", "@eslint/js"],
      "allowedVersions": "<10"
    },
    {
      "description": "chess.js is pinned: the chess adapter calls an internal method. Its own PR, never automerged: review packages/games/src/chess/chess-js.ts and run the perft tests.",
      "matchPackageNames": ["chess.js"],
      "groupName": "chess.js",
      "automerge": false,
      "labels": ["chess.js: xem adapter + perft"]
    }
  ]
}
